# Password your father uses to log in at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign login cookies (run: openssl rand -hex 32)
SESSION_SECRET=replace-with-64-random-hex-chars

# Business details shown on the site
NEXT_PUBLIC_SITE_NAME=DC Propertys
NEXT_PUBLIC_PHONE=+919999999999
NEXT_PUBLIC_WHATSAPP=919999999999
NEXT_PUBLIC_OFFICE_ADDRESS=Mathura, Uttar Pradesh
# Public URL once deployed (used for share links / SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the SQLite DB and uploaded photos live (default: ./data)
